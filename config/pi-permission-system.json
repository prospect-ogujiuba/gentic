{
  "$schema": "https://raw.githubusercontent.com/gotgenes/pi-packages/main/packages/pi-permission-system/schemas/permissions.schema.json",
  "debugLog": false,
  "permissionReviewLog": true,
  "yoloMode": false,
  "doublePressToConfirm": true,
  "permission": {
    "*": "allow",
    "path_read": "allow",
    "path_write": {
      "*": "allow",
      ".env": "deny",
      ".env/*": "deny",
      "*/.env": "deny",
      "*/.env/*": "deny",
      ".git": "deny",
      ".git/*": "deny",
      "*/.git": "deny",
      "*/.git/*": "deny"
    },
    "external_directory": "allow",
    "bash": {
      "*": "ask",
      "/home/*": "allow",
      "awk *": "allow",
      "basename *": "allow",
      "bash *": "allow",
      "cat *": "allow",
      "cd *": "allow",
      "code *": "allow",
      "command *": "allow",
      "cut *": "allow",
      "date*": "allow",
      "dirname *": "allow",
      "du *": "allow",
      "env": "allow",
      "env *": "allow",
      "file *": "allow",
      "find *": "allow",
      "for *": "allow",
      "git add *": "allow",
      "git branch*": "allow",
      "git check*": "allow",
      "git commit *": "allow",
      "git config --get*": "allow",
      "git diff*": "allow",
      "git grep*": "allow",
      "git log*": "allow",
      "git ls*": "allow",
      "git pull": "allow",
      "git remote*": "allow",
      "git rev*": "allow",
      "git show*": "allow",
      "git stash*": "allow",
      "git status*": "allow",
      "grep*": "allow",
      "head *": "allow",
      "if*": "allow",
      "jq *": "allow",
      "ls*": "allow",
      "mkdir *": "allow",
      "mv *": "allow",
      "node *": "allow",
      "npm audit*": "allow",
      "npm list*": "allow",
      "npm outdated*": "allow",
      "npm run *": "allow",
      "npm test*": "allow",
      "npm view*": "allow",
      "pi*": "allow",
      "printf *": "allow",
      "pwd*": "allow",
      "readlink *": "allow",
      "realpath *": "allow",
      "sed -n *": "allow",
      "sess*": "allow",
      "set *": "allow",
      "sort*": "allow",
      "source *": "allow",
      "stat *": "allow",
      "stow *": "allow",
      "tail *": "allow",
      "test *": "allow",
      "tmux *": "allow",
      "tmp*": "allow",
      "tree*": "allow",
      "type *": "allow",
      "uniq*": "allow",
      "wc*": "allow",
      "which *": "allow",
      "whoami": "allow",
      "rm -rf /": "deny",
      "rm -rf /*": "deny",
      "rm -fr /": "deny",
      "rm -fr /*": "deny",
      "rm /": "deny",
      "rm --force --recursive /": "deny",
      "*rm --force --recursive /": "deny",
      "*rm -r -f $HOME": "deny",
      "*rm -r -f ${HOME}": "deny",
      "*rm -r -f ~": "deny"
    }
  }
}
