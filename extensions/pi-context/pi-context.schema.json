{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://earendil.works/pi-context.schema.json",
  "title": "pi-context configuration",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "integer", "const": 1, "default": 1 },
    "pressure": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "warningPercent": { "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 100, "default": 25 },
        "criticalPercent": { "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 100, "default": 10 },
        "hysteresisPercent": { "type": "number", "minimum": 0, "maximum": 100, "default": 5 }
      },
      "default": {
        "warningPercent": 25,
        "criticalPercent": 10,
        "hysteresisPercent": 5
      }
    }
  }
}
