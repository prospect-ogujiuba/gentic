{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gentic.dev/schemas/pi-swe/workflow.schema.json",
  "title": "pi-swe workflow v2",
  "type": "object",
  "required": ["version", "topic", "revision", "status", "goal", "contract", "orchestration", "tasks", "updatedAt"],
  "properties": {
    "version": { "const": 2 },
    "topic": { "$ref": "#/$defs/topic" },
    "revision": { "type": "integer", "minimum": 1 },
    "status": { "enum": ["draft", "active", "paused", "blocked", "complete"] },
    "goal": { "$ref": "#/$defs/text" },
    "plan": { "$ref": "#/$defs/text" },
    "contract": { "$ref": "#/$defs/contract" },
    "orchestration": { "$ref": "#/$defs/orchestration" },
    "planReview": { "$ref": "#/$defs/report" },
    "initiativeVerification": { "type": "array", "maxItems": 16, "items": { "$ref": "#/$defs/command" } },
    "closeout": { "$ref": "#/$defs/closeout" },
    "initiativeAcceptance": { "$ref": "#/$defs/report" },
    "bootstrapAdoption": { "$ref": "#/$defs/bootstrapAdoption" },
    "activeTask": { "$ref": "#/$defs/taskId" },
    "tasks": { "type": "array", "minItems": 1, "maxItems": 100, "items": { "$ref": "#/$defs/task" } },
    "updatedAt": { "$ref": "#/$defs/timestamp" },
    "migration": { "$ref": "#/$defs/migration" },
    "importedFrom": { "$ref": "#/$defs/workflowImport" }
  },
  "additionalProperties": false,
  "$defs": {
    "topic": { "type": "string", "maxLength": 256, "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?:/[a-z0-9]+(?:-[a-z0-9]+)*)*$" },
    "taskId": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" },
    "text": { "type": "string", "minLength": 1, "maxLength": 2048 },
    "timestamp": { "type": "string", "format": "date-time" },
    "hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "contract": {
      "type": "object",
      "required": ["revision", "hash"],
      "properties": {
        "revision": { "type": "integer", "minimum": 1 },
        "hash": { "$ref": "#/$defs/hash" },
        "linkedPlanHash": { "$ref": "#/$defs/hash" }
      },
      "additionalProperties": false
    },
    "approach": { "enum": ["tdd", "diagnosis", "dsa", "security", "performance", "migration", "accessibility-ux", "operations"] },
    "approachReasons": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/approach" },
      "additionalProperties": { "type": "string", "minLength": 1, "maxLength": 1024 },
      "maxProperties": 8
    },
    "command": {
      "type": "object",
      "required": ["command", "args"],
      "properties": {
        "command": { "type": "string", "minLength": 1, "maxLength": 256 },
        "args": { "type": "array", "maxItems": 64, "items": { "type": "string", "maxLength": 512 } }
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "required": ["runId", "role", "actorId", "leaseId", "leaseFence", "contractHash", "startedAt", "completedAt"],
      "properties": {
        "runId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "role": { "enum": ["plan-reviewer", "implementer", "general-reviewer", "concern-reviewer", "final-reviewer"] },
        "actorId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "provider": { "type": "string", "minLength": 1, "maxLength": 256 },
        "model": { "type": "string", "minLength": 1, "maxLength": 256 },
        "leaseId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "leaseFence": { "type": "integer", "minimum": 1 },
        "contractHash": { "$ref": "#/$defs/hash" },
        "snapshotHash": { "type": "string", "minLength": 1, "maxLength": 128 },
        "startedAt": { "$ref": "#/$defs/timestamp" },
        "completedAt": { "$ref": "#/$defs/timestamp" }
      },
      "additionalProperties": false
    },
    "finding": {
      "type": "object",
      "required": ["id", "severity", "status", "summary", "evidence"],
      "properties": {
        "id": { "$ref": "#/$defs/taskId" },
        "severity": { "enum": ["blocking", "warning"] },
        "status": { "enum": ["open", "resolved", "accepted-risk"] },
        "summary": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "evidence": { "$ref": "#/$defs/text" },
        "disposition": { "$ref": "#/$defs/text" }
      },
      "additionalProperties": false
    },
    "clarification": {
      "type": "object",
      "required": ["id", "question", "askedByRunId", "askedAt"],
      "properties": {
        "id": { "$ref": "#/$defs/taskId" },
        "question": { "$ref": "#/$defs/text" },
        "askedByRunId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "askedAt": { "$ref": "#/$defs/timestamp" },
        "answer": { "$ref": "#/$defs/text" },
        "answeredBy": { "type": "string", "minLength": 1, "maxLength": 128 },
        "answeredAt": { "$ref": "#/$defs/timestamp" }
      },
      "additionalProperties": false
    },
    "report": {
      "type": "object",
      "required": ["kind", "outcome", "summary", "findings", "provenance"],
      "properties": {
        "kind": { "enum": ["plan-review", "implementation", "general-review", "concern-review", "final-acceptance"] },
        "outcome": { "enum": ["approved", "changes-requested", "needs-input", "completed", "no-change", "failed"] },
        "summary": { "$ref": "#/$defs/text" },
        "rationale": { "$ref": "#/$defs/text" },
        "changedPaths": { "type": "array", "maxItems": 128, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 512 } },
        "findings": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/finding" } },
        "questions": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/clarification" } },
        "provenance": { "$ref": "#/$defs/provenance" }
      },
      "additionalProperties": false
    },
    "lease": {
      "type": "object",
      "required": ["id", "runId", "ownerId", "stage", "fence", "acquiredAt", "expiresAt"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "runId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "stage": { "enum": ["plan-review", "task-execution", "initiative-acceptance", "complete", "pending", "implementation", "general-review", "concern-review", "remediation", "workspace", "integration", "verification", "ready-to-complete", "historical"] },
        "taskId": { "$ref": "#/$defs/taskId" },
        "fence": { "type": "integer", "minimum": 1 },
        "acquiredAt": { "$ref": "#/$defs/timestamp" },
        "expiresAt": { "$ref": "#/$defs/timestamp" }
      },
      "additionalProperties": false
    },
    "history": {
      "type": "object",
      "required": ["id", "type", "at", "summary"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "type": { "type": "string", "minLength": 1, "maxLength": 128 },
        "at": { "$ref": "#/$defs/timestamp" },
        "summary": { "$ref": "#/$defs/text" },
        "taskId": { "$ref": "#/$defs/taskId" },
        "provenance": { "$ref": "#/$defs/provenance" },
        "auditCritical": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "orchestration": {
      "type": "object",
      "required": ["mode", "phase", "nextFence", "history"],
      "properties": {
        "mode": { "enum": ["legacy", "multi-agent"] },
        "phase": { "enum": ["plan-review", "task-execution", "initiative-acceptance", "complete"] },
        "nextFence": { "type": "integer", "minimum": 1 },
        "activeRun": { "$ref": "#/$defs/lease" },
        "parent": { "$ref": "#/$defs/parentAuthority" },
        "runtimeHandoff": { "$ref": "#/$defs/runtimeHandoff" },
        "history": { "type": "array", "maxItems": 128, "items": { "$ref": "#/$defs/history" } }
      },
      "allOf": [
        {
          "if": { "properties": { "runtimeHandoff": { "properties": { "phase": { "const": "prepared" } }, "required": ["phase"] } }, "required": ["runtimeHandoff"] },
          "then": { "properties": { "parent": { "properties": { "valid": { "const": false } }, "required": ["valid"] } } }
        },
        {
          "if": { "properties": { "runtimeHandoff": { "properties": { "phase": { "const": "reclaimed" } }, "required": ["phase"] } }, "required": ["runtimeHandoff"] },
          "then": { "required": ["parent"] }
        }
      ],
      "additionalProperties": false
    },
    "parentAuthority": {
      "type": "object",
      "required": ["ownerId", "sessionId", "runtimeId", "cwd", "claimedAt", "valid"],
      "properties": {
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "sessionId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "runtimeId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "cwd": { "$ref": "#/$defs/text" },
        "sessionFile": { "$ref": "#/$defs/text" },
        "claimedAt": { "$ref": "#/$defs/timestamp" },
        "valid": { "type": "boolean" },
        "invalidatedAt": { "$ref": "#/$defs/timestamp" },
        "invalidatedReason": { "$ref": "#/$defs/text" }
      },
      "additionalProperties": false
    },
    "runtimeHandoff": {
      "type": "object",
      "required": ["id", "decisionId", "from", "to", "phase", "selectorGeneration", "preparedAt"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "decisionId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "decision": { "$ref": "#/$defs/gate2DecisionAttestation" },
        "from": { "enum": ["compatibility", "v2"] },
        "to": { "enum": ["compatibility", "v2"] },
        "phase": { "enum": ["prepared", "reclaimed"] },
        "selectorGeneration": { "type": "integer", "minimum": 1 },
        "preparedAt": { "$ref": "#/$defs/timestamp" },
        "reclaimedAt": { "$ref": "#/$defs/timestamp" },
        "previousParent": { "$ref": "#/$defs/parentAuthority" }
      },
      "allOf": [
        { "if": { "properties": { "phase": { "const": "prepared" } }, "required": ["phase"] }, "then": { "required": ["decision"] } }
      ],
      "additionalProperties": false
    },
    "gate2DecisionAttestation": {
      "type": "object",
      "required": ["decisionId", "authorizedBy", "authorizedAt", "readinessEvidenceHash", "migrationEvidenceHash", "targetRuntime", "rollbackSelector", "rollbackWindowEnd", "rationale"],
      "properties": {
        "decisionId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "authorizedBy": { "type": "string", "minLength": 1, "maxLength": 128 },
        "authorizedAt": { "$ref": "#/$defs/timestamp" },
        "readinessEvidenceHash": { "const": "sha256:c20d05e239978d456801410ac986c22ef21c7f78bb6e3cad485a00181fabfadc" },
        "migrationEvidenceHash": { "const": "sha256:0b40a9d1b4352408d0b22ba3814cd0858ebd13e7c04728e563adf294ccd5f157" },
        "targetRuntime": { "const": "v2" },
        "rollbackSelector": { "const": "compatibility" },
        "rollbackWindowEnd": { "$ref": "#/$defs/timestamp" },
        "rationale": { "$ref": "#/$defs/text" }
      },
      "additionalProperties": false
    },
    "checkpoint": {
      "type": "object",
      "required": ["revision", "at"],
      "properties": {
        "revision": { "type": "integer", "minimum": 1 },
        "at": { "$ref": "#/$defs/timestamp" },
        "sessionId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "branchLength": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": ["command", "args", "exitCode", "at"],
      "properties": {
        "command": { "type": "string", "minLength": 1, "maxLength": 256 },
        "args": { "type": "array", "maxItems": 64, "items": { "type": "string", "maxLength": 512 } },
        "exitCode": { "type": "integer" },
        "at": { "$ref": "#/$defs/timestamp" },
        "contractHash": { "$ref": "#/$defs/hash" },
        "snapshotHash": { "type": "string", "minLength": 1, "maxLength": 128 },
        "cwd": { "$ref": "#/$defs/text" },
        "branch": { "type": ["string", "null"], "minLength": 1, "maxLength": 512 },
        "head": { "type": "string", "minLength": 1, "maxLength": 128 },
        "beforeSnapshotHash": { "type": "string", "minLength": 1, "maxLength": 128 },
        "afterSnapshotHash": { "type": "string", "minLength": 1, "maxLength": 128 },
        "source": {
          "type": "object",
          "required": ["kind", "toolCallId", "workflowRevision"],
          "properties": {
            "kind": { "const": "bash-tool-result" },
            "toolCallId": { "type": "string", "minLength": 1, "maxLength": 128 },
            "toolName": { "const": "bash" },
            "workflowRevision": { "type": "integer", "minimum": 1 },
            "sessionId": { "type": "string", "minLength": 1, "maxLength": 128 },
            "ownerId": { "type": "string", "minLength": 1, "maxLength": 128 },
            "runtimeId": { "type": "string", "minLength": 1, "maxLength": 128 },
            "sessionFile": { "$ref": "#/$defs/text" },
            "sessionBranchId": { "type": "string", "minLength": 1, "maxLength": 128 },
            "branchLength": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "repositorySnapshot": {
      "type": "object",
      "required": ["hash", "head", "branch", "changedPaths", "capturedAt"],
      "properties": {
        "hash": { "type": "string", "minLength": 1, "maxLength": 128 },
        "head": { "type": "string", "minLength": 1, "maxLength": 128 },
        "branch": { "type": ["string", "null"], "minLength": 1, "maxLength": 512 },
        "changedPaths": { "type": "array", "maxItems": 256, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 512 } },
        "capturedAt": { "$ref": "#/$defs/timestamp" }
      },
      "additionalProperties": false
    },
    "bootstrapAdoption": {
      "type": "object",
      "required": ["anchorCommit", "descendantHead", "snapshot", "taskIds", "planReview", "generalReview", "checks", "decisions", "authorization", "adoptedAt"],
      "properties": {
        "anchorCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "descendantHead": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "snapshot": { "$ref": "#/$defs/repositorySnapshot" },
        "taskIds": { "type": "array", "minItems": 1, "maxItems": 100, "items": { "$ref": "#/$defs/taskId" } },
        "planReview": { "$ref": "#/$defs/report" },
        "generalReview": { "$ref": "#/$defs/report" },
        "concernReview": {
          "type": "object",
          "required": ["concerns", "report"],
          "properties": { "concerns": { "type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": { "$ref": "#/$defs/approach" } }, "report": { "$ref": "#/$defs/report" } },
          "additionalProperties": false
        },
        "checks": {
          "type": "array", "maxItems": 3200,
          "items": { "type": "object", "required": ["taskId", "evidence"], "properties": { "taskId": { "$ref": "#/$defs/taskId" }, "evidence": { "$ref": "#/$defs/evidence" } }, "additionalProperties": false }
        },
        "decisions": {
          "type": "array", "maxItems": 64,
          "items": { "type": "object", "required": ["findingId", "disposition", "decidedBy", "at"], "properties": { "findingId": { "type": "string", "minLength": 1, "maxLength": 128 }, "disposition": { "$ref": "#/$defs/text" }, "decidedBy": { "type": "string", "minLength": 1, "maxLength": 128 }, "at": { "$ref": "#/$defs/timestamp" } }, "additionalProperties": false }
        },
        "authorization": {
          "type": "object", "required": ["id", "authorizedBy", "ownerId", "sessionId", "runtimeId", "authorizedAt"],
          "properties": { "id": { "type": "string", "minLength": 1, "maxLength": 128 }, "authorizedBy": { "type": "string", "minLength": 1, "maxLength": 128 }, "ownerId": { "type": "string", "minLength": 1, "maxLength": 128 }, "sessionId": { "type": "string", "minLength": 1, "maxLength": 128 }, "runtimeId": { "type": "string", "minLength": 1, "maxLength": 128 }, "authorizedAt": { "$ref": "#/$defs/timestamp" } },
          "additionalProperties": false
        },
        "adoptedAt": { "$ref": "#/$defs/timestamp" }
      },
      "additionalProperties": false
    },
    "closeout": {
      "type": "object",
      "required": ["snapshot", "cumulativeDeltaHash", "checkpoint", "evidence", "unresolvedRisks", "blockingRisks", "followUpTaskIds"],
      "properties": {
        "snapshot": { "$ref": "#/$defs/repositorySnapshot" },
        "cumulativeDeltaHash": { "$ref": "#/$defs/hash" },
        "checkpoint": {
          "type": "object",
          "required": ["revision", "at", "ownerId", "sessionId", "runtimeId", "branchLength"],
          "properties": {
            "revision": { "type": "integer", "minimum": 1 }, "at": { "$ref": "#/$defs/timestamp" },
            "ownerId": { "type": "string", "minLength": 1, "maxLength": 128 }, "sessionId": { "type": "string", "minLength": 1, "maxLength": 128 },
            "runtimeId": { "type": "string", "minLength": 1, "maxLength": 128 }, "branchLength": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        },
        "evidence": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/evidence" } },
        "unresolvedRisks": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 1024 } },
        "blockingRisks": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 1024 } },
        "followUpTaskIds": { "type": "array", "maxItems": 100, "uniqueItems": true, "items": { "$ref": "#/$defs/taskId" } },
        "manualValidation": {
          "type": "object", "required": ["status", "rationale", "at"],
          "properties": { "status": { "enum": ["required", "approved", "rejected"] }, "rationale": { "$ref": "#/$defs/text" }, "decidedBy": { "type": "string", "minLength": 1, "maxLength": 128 }, "at": { "$ref": "#/$defs/timestamp" } },
          "allOf": [{ "if": { "properties": { "status": { "enum": ["approved", "rejected"] } }, "required": ["status"] }, "then": { "required": ["decidedBy"] } }],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "workspaceReceipt": {
      "type": "object",
      "required": ["workspaceId", "baselineHash", "snapshotHash", "changedPaths", "createdAt"],
      "properties": {
        "workspaceId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "baselineHash": { "type": "string", "minLength": 1, "maxLength": 128 },
        "snapshotHash": { "type": "string", "minLength": 1, "maxLength": 128 },
        "changedPaths": { "type": "array", "maxItems": 128, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 512 } },
        "createdAt": { "$ref": "#/$defs/timestamp" },
        "version": { "const": 1 },
        "root": { "$ref": "#/$defs/text" },
        "path": { "$ref": "#/$defs/text" },
        "taskId": { "$ref": "#/$defs/taskId" },
        "topic": { "type": "string", "minLength": 1, "maxLength": 256 },
        "baselineCommit": { "type": "string", "minLength": 1, "maxLength": 128 },
        "baselineRef": { "type": "string", "minLength": 1, "maxLength": 256 },
        "worktreeGitDir": { "$ref": "#/$defs/text" },
        "ownershipToken": { "type": "string", "minLength": 1, "maxLength": 128 },
        "intentPath": { "$ref": "#/$defs/text" },
        "workspaceHeadCommit": { "type": "string", "minLength": 1, "maxLength": 128 },
        "preparedResultCommit": { "type": "string", "minLength": 1, "maxLength": 128 },
        "preparedResultRef": { "type": "string", "minLength": 1, "maxLength": 256 },
        "preparedPatchHash": { "type": "string", "minLength": 1, "maxLength": 128 },
        "realHead": { "type": "string", "minLength": 1, "maxLength": 128 },
        "realBranch": { "type": ["string", "null"], "minLength": 1, "maxLength": 512 },
        "realIndexHash": { "type": "string", "minLength": 1, "maxLength": 128 },
        "realIndexTree": { "type": "string", "minLength": 1, "maxLength": 128 },
        "stagedPatchHash": { "type": "string", "minLength": 1, "maxLength": 128 },
        "unstagedPatchHash": { "type": "string", "minLength": 1, "maxLength": 128 },
        "realSourceSnapshotHash": { "type": "string", "minLength": 1, "maxLength": 128 },
        "includedUntracked": { "type": "array", "maxItems": 128, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 512 } },
        "baselineUntrackedPathHashes": { "type": "array", "maxItems": 512, "uniqueItems": true, "items": { "$ref": "#/$defs/hash" } },
        "managedPaths": { "type": "array", "maxItems": 128, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 512 } },
        "integrationBaseCommit": { "type": "string", "minLength": 1, "maxLength": 128 },
        "writeScope": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 512 } }
      },
      "allOf": [{ "if": { "required": ["version"], "properties": { "version": { "const": 1 } } }, "then": { "required": ["root", "path", "taskId", "topic", "baselineCommit", "baselineRef", "worktreeGitDir", "ownershipToken", "intentPath", "workspaceHeadCommit", "realHead", "realIndexHash", "realIndexTree", "stagedPatchHash", "unstagedPatchHash", "realSourceSnapshotHash", "includedUntracked", "managedPaths", "writeScope"] } }],
      "additionalProperties": false
    },
    "integrationReceipt": {
      "type": "object",
      "required": ["integrationId", "preSnapshotHash", "postSnapshotHash", "patchHash", "integratedAt"],
      "properties": {
        "integrationId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "preSnapshotHash": { "type": "string", "minLength": 1, "maxLength": 128 },
        "postSnapshotHash": { "type": "string", "minLength": 1, "maxLength": 128 },
        "patchHash": { "type": "string", "minLength": 1, "maxLength": 128 },
        "integratedAt": { "$ref": "#/$defs/timestamp" },
        "version": { "const": 1 },
        "workspaceId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "resultCommit": { "type": "string", "minLength": 1, "maxLength": 128 },
        "resultRef": { "type": "string", "minLength": 1, "maxLength": 256 },
        "observedHead": { "type": "string", "minLength": 1, "maxLength": 128 },
        "observedBranch": { "type": ["string", "null"], "minLength": 1, "maxLength": 512 },
        "observedIndexHash": { "type": "string", "minLength": 1, "maxLength": 128 },
        "changedPaths": { "type": "array", "maxItems": 128, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 512 } }
      },
      "allOf": [{ "if": { "required": ["version"], "properties": { "version": { "const": 1 } } }, "then": { "required": ["workspaceId", "resultCommit", "resultRef", "observedHead", "observedIndexHash", "changedPaths"] } }],
      "additionalProperties": false
    },
    "task": {
      "type": "object",
      "required": ["id", "title", "kind", "status", "phase", "dependsOn", "acceptance", "approaches", "approachReasons", "assessmentStatus", "writeScope", "nonGoals", "contract", "verification", "evidence", "evidenceLinks", "reports", "clarifications", "findings", "remediation"],
      "properties": {
        "id": { "$ref": "#/$defs/taskId" },
        "title": { "type": "string", "minLength": 1, "maxLength": 256 },
        "kind": { "enum": ["implementation", "coordination"] },
        "status": { "enum": ["pending", "active", "blocked", "deferred", "complete"] },
        "phase": { "enum": ["pending", "implementation", "general-review", "concern-review", "remediation", "workspace", "integration", "verification", "ready-to-complete", "historical"] },
        "dependsOn": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "$ref": "#/$defs/taskId" } },
        "acceptance": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 1024 } },
        "approaches": { "type": "array", "maxItems": 8, "uniqueItems": true, "items": { "$ref": "#/$defs/approach" } },
        "approachReasons": { "$ref": "#/$defs/approachReasons" },
        "assessmentStatus": { "enum": ["assessed", "unassessed"] },
        "writeScope": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 512 } },
        "nonGoals": { "type": "array", "maxItems": 32, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 1024 } },
        "contract": { "$ref": "#/$defs/contract" },
        "verification": { "type": "array", "maxItems": 16, "items": { "$ref": "#/$defs/command" } },
        "verificationDecision": {
          "type": "object",
          "required": ["kind", "rationale", "decidedBy", "at"],
          "properties": {
            "kind": { "const": "manual" },
            "rationale": { "$ref": "#/$defs/text" },
            "decidedBy": { "type": "string", "minLength": 1, "maxLength": 128 },
            "at": { "$ref": "#/$defs/timestamp" }
          },
          "additionalProperties": false
        },
        "verificationCheckpoint": { "$ref": "#/$defs/checkpoint" },
        "evidence": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/evidence" } },
        "evidenceLinks": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "$ref": "#/$defs/text" } },
        "reports": { "type": "array", "maxItems": 16, "items": { "$ref": "#/$defs/report" } },
        "clarifications": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/clarification" } },
        "findings": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/finding" } },
        "remediation": {
          "type": "object",
          "required": ["used", "max"],
          "properties": { "used": { "type": "integer", "minimum": 0, "maximum": 8 }, "max": { "type": "integer", "minimum": 0, "maximum": 8 } },
          "additionalProperties": false
        },
        "workspaceReceipt": { "$ref": "#/$defs/workspaceReceipt" },
        "integrationReceipt": { "$ref": "#/$defs/integrationReceipt" },
        "verificationDriftPaths": { "type": "array", "maxItems": 128, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 512 } },
        "blockedReason": { "$ref": "#/$defs/text" },
        "completedAt": { "$ref": "#/$defs/timestamp" },
        "importedFrom": { "type": "object", "required": ["kind", "contractPath"], "properties": { "kind": { "const": "pi-swe-v2-contract" }, "contractPath": { "$ref": "#/$defs/text" }, "contentHash": { "type": "string", "maxLength": 128 }, "completion": { "type": "object", "maxProperties": 16 } }, "additionalProperties": false }
      },
      "additionalProperties": false
    },
    "migration": {
      "type": "object",
      "required": ["sourceVersion", "readAt", "historicalTaskIds"],
      "properties": {
        "sourceVersion": { "const": 1 },
        "readAt": { "$ref": "#/$defs/timestamp" },
        "historicalTaskIds": { "type": "array", "maxItems": 100, "uniqueItems": true, "items": { "$ref": "#/$defs/taskId" } },
        "disposition": { "enum": ["continue", "reopen", "grandfather-read-only"] },
        "decidedBy": { "type": "string", "minLength": 1, "maxLength": 128 },
        "preimageHash": { "$ref": "#/$defs/hash" }
      },
      "additionalProperties": false
    },
    "workflowImport": {
      "type": "object",
      "required": ["kind", "manifestPath"],
      "properties": {
        "kind": { "const": "pi-swe-v2" },
        "manifestPath": { "$ref": "#/$defs/text" },
        "planRevision": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    }
  }
}
