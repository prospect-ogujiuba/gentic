{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gentic.dev/schemas/pi-swe/runtime.schema.json",
  "title": "pi-swe durable runtime selector",
  "type": "object",
  "required": ["schemaVersion", "generation", "selectedRuntime", "controllingTopic", "decision", "handoff"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "generation": { "type": "integer", "minimum": 1 },
    "selectedRuntime": { "enum": ["compatibility", "v2"] },
    "controllingTopic": { "const": "swe-production-rollout" },
    "decision": { "$ref": "#/$defs/decision" },
    "handoff": { "$ref": "#/$defs/handoff" }
  },
  "additionalProperties": false,
  "$defs": {
    "text": { "type": "string", "minLength": 1, "maxLength": 2048 },
    "id": { "type": "string", "minLength": 1, "maxLength": 128, "not": { "pattern": "^<.*>$" } },
    "timestamp": { "type": "string", "format": "date-time" },
    "hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "decision": {
      "type": "object",
      "required": ["decisionId", "authorizedBy", "authorizedAt", "readinessEvidenceHash", "migrationEvidenceHash", "targetRuntime", "rollbackSelector", "rollbackWindowEnd", "rationale"],
      "properties": {
        "decisionId": { "$ref": "#/$defs/id" },
        "authorizedBy": { "$ref": "#/$defs/id" },
        "authorizedAt": { "$ref": "#/$defs/timestamp" },
        "readinessEvidenceHash": { "$ref": "#/$defs/hash" },
        "migrationEvidenceHash": { "$ref": "#/$defs/hash" },
        "targetRuntime": { "const": "v2" },
        "rollbackSelector": { "const": "compatibility" },
        "rollbackWindowEnd": { "$ref": "#/$defs/timestamp" },
        "rationale": { "$ref": "#/$defs/text" }
      },
      "additionalProperties": false
    },
    "parent": {
      "type": "object",
      "required": ["ownerId", "sessionId", "runtimeId"],
      "properties": {
        "ownerId": { "$ref": "#/$defs/id" },
        "sessionId": { "$ref": "#/$defs/id" },
        "runtimeId": { "$ref": "#/$defs/id" }
      },
      "additionalProperties": false
    },
    "handoff": {
      "type": "object",
      "required": ["id", "from", "to", "preparedWorkflowRevision", "preparedAt", "selectedAt", "parent"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "from": { "enum": ["compatibility", "v2"] },
        "to": { "enum": ["compatibility", "v2"] },
        "preparedWorkflowRevision": { "type": "integer", "minimum": 1 },
        "preparedAt": { "$ref": "#/$defs/timestamp" },
        "selectedAt": { "$ref": "#/$defs/timestamp" },
        "parent": { "$ref": "#/$defs/parent" }
      },
      "additionalProperties": false
    }
  }
}
