{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://earendil.works/pi-gate.schema.json",
  "title": "pi-gate config",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "integer", "minimum": 1, "maximum": 3, "default": 3 },
    "enabled": { "type": "boolean", "default": true },
    "mode": { "enum": ["ask", "strict", "permissive"], "default": "ask" },
    "defaultAction": { "enum": ["allow", "deny", "ask"], "default": "ask" },
    "projectTrust": { "enum": ["defer", "ask", "allow", "deny"], "default": "defer" },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean", "default": true },
        "path": { "type": "string", "default": ".pi/pi-gate/pi-gate-audit.jsonl" },
        "maxBytes": { "type": "integer", "minimum": 1024, "default": 1048576 }
      }
    },
    "permissions": { "$ref": "#/$defs/permissions" },
    "literalPermissions": {
      "$ref": "#/$defs/permissions",
      "description": "Exact command literals written by remembered decisions. Wildcard characters have no special meaning."
    },
    "protectedPaths": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "read": { "$ref": "#/$defs/patterns" },
        "edit": { "$ref": "#/$defs/patterns" },
        "write": { "$ref": "#/$defs/patterns" }
      }
    }
  },
  "$defs": {
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allow": { "$ref": "#/$defs/patterns" },
        "ask": { "$ref": "#/$defs/patterns" },
        "deny": { "$ref": "#/$defs/patterns" }
      },
      "default": {}
    },
    "patterns": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    }
  }
}
