{
  "name": "gentic",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/prospect-ogujiuba/gentic.git"
  },
  "homepage": "https://github.com/prospect-ogujiuba/gentic#readme",
  "bugs": {
    "url": "https://github.com/prospect-ogujiuba/gentic/issues"
  },
  "keywords": [
    "pi-package",
    "gentic",
    "suite"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.84.2",
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@earendil-works/pi-tui": "0.84.2",
    "@gotgenes/pi-permission-system": "27.1.3",
    "typebox": "1.3.7"
  },
  "devDependencies": {
    "@types/node": "22.19.0",
    "tsx": "4.23.13",
    "typescript": "5.9.3"
  },
  "bundledDependencies": [
    "@gotgenes/pi-permission-system"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "check": "npm run check:pi-api && npm run check:catalog && npm run check:inventory && npm run check:anatomy && npm run check:resources",
    "check:pi-api": "node scripts/check-pi-extension-api.mjs",
    "generate:catalog": "node --experimental-strip-types scripts/generate-pi-catalog.ts",
    "check:catalog": "node --experimental-strip-types scripts/generate-pi-catalog.ts --check",
    "generate:inventory": "node --experimental-strip-types scripts/generate-gentic-inventory.ts",
    "check:inventory": "node --experimental-strip-types scripts/generate-gentic-inventory.ts --check",
    "check:anatomy": "node scripts/check-extension-anatomy.mjs",
    "check:resources": "node --experimental-strip-types scripts/check-package-resources.ts",
    "check:commands": "node scripts/check-command-inventory.mjs",
    "check:performance": "node --experimental-strip-types scripts/check-performance-budgets.ts",
    "pi:update": "node --experimental-strip-types scripts/pi-update.ts",
    "release:verify": "node --experimental-strip-types scripts/release-verify.ts",
    "test": "node --experimental-strip-types --test test/**/*.test.ts",
    "test:todo": "node --experimental-strip-types --test test/pi-todo*.test.ts",
    "test:swe": "node --experimental-strip-types --test test/pi-swe*.test.ts",
    "test:permissions": "node --experimental-strip-types --test test/pi-permission*.test.ts",
    "test:primitives": "node --experimental-strip-types --test test/pi-primitives.test.ts"
  },
  "pi": {
    "extensions": [
      "./extensions",
      "./node_modules/@gotgenes/pi-permission-system/src/index.ts"
    ],
    "skills": [
      "./skills",
      "./extensions/**/skills",
      "!./skills/**/README.md",
      "!./extensions/**/skills/**/README.md"
    ],
    "prompts": [
      "./prompts/**/*.md",
      "./extensions/**/prompts/**/*.md",
      "!./prompts/**/README.md",
      "!./extensions/**/prompts/**/README.md"
    ],
    "themes": [
      "./themes/**/*.json",
      "./extensions/**/themes/**/*.json"
    ]
  },
  "bundleDependencies": [
    "@gotgenes/pi-permission-system"
  ]
}
