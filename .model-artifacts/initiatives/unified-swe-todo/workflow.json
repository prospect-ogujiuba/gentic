{
  "kind": "gentic.swe.initiative",
  "schemaVersion": 1,
  "id": "unified-swe-todo",
  "revision": 29,
  "status": "complete",
  "objective": "Consolidate standalone todo functionality and workflow-backed work projection into the pi-swe extension so one reliable todo surface operates standalone or delegates active workflow mutations to SweService without duplicate task authority.",
  "scope": {
    "in": [
      "Move the existing branch-backed todo core and public todo surface under pi-swe",
      "Introduce a provider-neutral todo view/backend contract",
      "Add a workflow-backed provider that projects workflow.json and routes legal mutations through SweService",
      "Replace duplicate todo/SWE docket and modal implementations with one capability-driven UI",
      "Make pi-swe the sole registration point for both swe and todo commands/tools",
      "Remove obsolete optional lifecycle bridging and independent pi-todo extension discovery",
      "Preserve existing branch todo entries and public todo behavior in standalone mode",
      "Update tests, documentation, anatomy, catalog, and inventory"
    ],
    "out": [
      "Changing workflow.json schema version or weakening its validation and evidence gates",
      "Copying workflow work into standalone todo session state",
      "Allowing todo finish to bypass implemented, verification, review, or completion gates",
      "Committing or pushing changes without separate authorization"
    ]
  },
  "constraints": [
    "workflow.json remains the sole planning authority whenever a focused active initiative owns the todo surface",
    "Standalone branch entries remain the sole authority outside active workflow mode",
    "Backend selection must be deterministic and reread current workflow authority before mutation",
    "Existing todo session entries must remain readable without migration",
    "Unsupported workflow structural mutations must fail with guidance to use intentional swe revision",
    "Exactly one todo command and tool may be registered"
  ],
  "acceptanceCriteria": [
    {
      "id": "AC-1",
      "text": "Loading pi-swe alone exposes the existing standalone todo command, structured tool, persistence behavior, and modal functionality without requiring pi-todo."
    },
    {
      "id": "AC-2",
      "text": "A focused active initiative is rendered directly from workflow.json through the todo surface, and legal lifecycle actions mutate only through SweService."
    },
    {
      "id": "AC-3",
      "text": "Standalone and workflow state are never synchronized or duplicated, and deterministic switching preserves inactive standalone state."
    },
    {
      "id": "AC-4",
      "text": "One shared capability-driven docket and modal represent standalone and workflow states including hierarchy, readiness, phases, and distinct implemented versus complete states."
    },
    {
      "id": "AC-5",
      "text": "The independent pi-todo registration and optional lifecycle bridge are removed without duplicate registrations or regressions in supported command and tool behavior."
    },
    {
      "id": "AC-6",
      "text": "Typecheck, todo tests, SWE tests, full tests, repository checks, and release verification pass with current evidence."
    }
  ],
  "assessment": {
    "depth": "deep",
    "reason": "This consolidation changes extension discovery, state authority selection, persistence compatibility, lifecycle routing, public tool behavior, and two interactive UI implementations.",
    "surfaces": [
      "extensions/pi-swe",
      "extensions/pi-todo",
      "src/lifecycle-coordination.ts",
      "test/pi-todo*.test.ts",
      "test/pi-swe*.test.ts",
      "catalog and extension anatomy metadata",
      "package-level extension discovery"
    ],
    "unknowns": [
      "Whether all existing todo public result shapes can remain byte-compatible while exposing workflow-specific statuses",
      "Which paused and draft workflow states should be visible versus actionable through todo",
      "Whether lifecycle coordination has consumers outside pi-swe and pi-todo"
    ]
  },
  "practices": [
    {
      "id": "P-1",
      "practice": "characterization-first compatibility",
      "appliesTo": [
        "W-1",
        "W-2"
      ],
      "reason": "Existing standalone todo branch persistence and public behavior must survive relocation unchanged."
    },
    {
      "id": "P-2",
      "practice": "authority-bound adapter design",
      "appliesTo": [
        "W-3"
      ],
      "reason": "Workflow projection must avoid a second ledger and preserve SweService mutation and evidence boundaries."
    },
    {
      "id": "P-3",
      "practice": "shared presentation refactor",
      "appliesTo": [
        "W-4"
      ],
      "reason": "The duplicate modals and dockets should converge behind a provider-neutral view without losing domain distinctions."
    },
    {
      "id": "P-4",
