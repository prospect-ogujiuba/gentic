      "dimensions": [
        "correctness",
        "authority-isolation",
        "lifecycle-gates",
        "provider-switching",
        "ui-capabilities",
        "registration-retirement",
        "compatibility",
        "verification"
      ],
      "summary": "Model self-review (not independent or human): no blocking findings. The final source resolves the backend on every operation, fails closed for unreadable focused authority, preserves standalone branch events without synchronization, routes workflow start and finish only through SweService with finish stopping at implemented, retains implemented versus complete in the shared capability-driven docket/modal, and registers swe/todo exactly once from pi-swe after deleting pi-todo and the lifecycle bridge. Characterization, workflow adapter, UI, inventory, full-suite, checks, performance, and release verification evidence all pass; the unrelated HUD process-timing assertions were made load-tolerant without weakening their timeout/output/cancellation expectations.",
      "provenance": {
        "kind": "pi-model-self-review",
        "sessionId": "01a0cfd1-5883-725c-980d-138152cef05c"
      }
    }
  ],
  "decisions": [
    {
      "id": "D-1",
      "text": "Todo is a capability owned and registered by pi-swe rather than a peer extension.",
      "basis": "This removes optional extension ordering and duplicated interactive surfaces while preserving standalone functionality."
    },
    {
      "id": "D-2",
      "text": "Workflow mode projects current workflow authority and never mirrors work into branch todo entries.",
      "basis": "workflow.json must remain the only workflow task ledger."
    },
    {
      "id": "D-3",
      "text": "Todo finish maps to implemented in workflow mode, never complete.",
      "basis": "SWE completion remains verification, review, and evidence gated."
    },
    {
      "id": "D-4",
      "text": "Workflow structural actions unsupported by an exact legal service operation remain disabled and direct users to swe revise.",
      "basis": "Generic todo CRUD must not bypass intentional revision rationale or compare-and-swap integrity."
    }
  ],
  "risks": [
    {
      "id": "R-1",
      "text": "Moving the standalone core could make historic branch todo entries unreadable.",
      "mitigation": "Preserve entry discriminants and payloads and add fixture-based compatibility tests before relocation."
    },
    {
      "id": "R-2",
      "text": "A cached backend could mutate stale or incorrect authority after initiative transitions.",
      "mitigation": "Resolve backend and reread workflow status for each operation and modal opening."
    },
    {
      "id": "R-3",
      "text": "A generic status model could erase the difference between implemented and complete.",
      "mitigation": "Carry provider-specific raw status and capability metadata through the view model."
    },
    {
      "id": "R-4",
      "text": "Both old and new extension entrypoints could register duplicate todo commands or tools.",
      "mitigation": "Add registration-count tests and remove independent discovery atomically."
    },
    {
      "id": "R-5",
      "text": "Broad UI refactoring could regress terminal keyboard, scrolling, and rendering behavior.",
      "mitigation": "Retain existing characterization tests and add provider-specific shared UI coverage."
    }
  ]
}
