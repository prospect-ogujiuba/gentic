  "decisions": [
    {
      "id": "D-1",
      "text": "Todo becomes a distinct ownership boundary while initiative Todo remains a workflow projection contract.",
      "basis": "This follows the review recommendation without introducing synchronization or a second initiative ledger."
    },
    {
      "id": "D-2",
      "text": "Shared docket code owns presentation only.",
      "basis": "Lifecycle and persistence coupling would recreate the architecture problem in a new shared module."
    }
  ],
  "risks": [
    {
      "id": "R-1",
      "text": "The physical split changes registration order or public discovery.",
      "mitigation": "Characterize discovery and retain compatibility adapters until package registration tests pass."
    },
    {
      "id": "R-2",
      "text": "Shared UI begins owning lifecycle decisions.",
      "mitigation": "Use intent-only interfaces and enforce forbidden imports in production shared UI."
    },
    {
      "id": "R-3",
      "text": "Persistence formats drift during module moves.",
      "mitigation": "Use existing fixtures, byte/schema compatibility tests, and malformed-state negative cases."
    },
    {
      "id": "R-4",
      "text": "Verification or completion permission boundaries weaken.",
      "mitigation": "Retain ordinary-bash observation tests and independently review mutation ownership."
    }
  ]
