  "decisions": [
    {
      "id": "D-1",
      "text": "Templates move beside pi-commands rather than into a new scaffolding package.",
      "basis": "It is the smallest ownership correction and avoids creating another package for one current consumer."
    },
    {
      "id": "D-2",
      "text": "Retain /scaffold primitive unchanged for this initiative set; source-plan removal/deprecation is deferred.",
      "basis": "No release-level breaking-change approval exists, and the coordination authority explicitly preserves generated scaffold bytes and public behavior."
    },
    {
      "id": "D-3",
      "text": "Run this work in the same post-provider wave as initiatives 04 and 05 when capacity permits.",
      "basis": "The consolidation plan treats UI, publication, and scaffolding migrations as separable rollback surfaces."
    }
  ],
  "risks": [
    {
      "id": "R-1",
      "text": "Template relocation changes generated bytes or paths.",
      "mitigation": "Use per-kind golden previews and applied-tree comparisons."
    },
    {
      "id": "R-2",
      "text": "Splitting transactional code weakens rollback or containment.",
      "mitigation": "Keep adversarial application tests and separate pure planning/rendering from mutation."
    },
    {
      "id": "R-3",
      "text": "Stale resource/inventory paths survive the move.",
      "mitigation": "Run repository-wide old-path checks and regenerate capability fixtures."
    }
  ]
}
