{
  "kind": "gentic.swe.initiative",
  "schemaVersion": 1,
  "id": "06-pi-commands-catalog-ownership",
  "revision": 26,
  "status": "complete",
  "objective": "Correct pi-commands and pi-catalog ownership by moving scaffold templates beside the scaffolder, splitting scaffold planning, rendering, and transactional application, and leaving pi-catalog focused on runtime discovery without changing generated bytes or public command behavior.",
  "policies": {
    "commitOnWorkCompletion": false,
    "independentReviewOnCompletion": true
  },
  "scope": {
    "in": [
      "Characterize /scaffold parsing, completions, previews, generated bytes and paths, staging, commit/rollback, containment, symlink, collision, and error behavior for every supported kind.",
      "Move extensions/pi-catalog/templates to extensions/pi-commands/templates with history-preserving renames.",
      "Update template-root containment, TypeScript/resource/anatomy checks, documentation, tests, and generated inventory references.",
      "Split the scaffolder into planning, rendering, and transactional application concerns while preserving its public surface.",
      "Remove generation-template ownership and claims from pi-catalog while retaining runtime command/tool discovery."
    ],
    "out": [
      "Changing /catalog or runtime discovery behavior.",
      "Changing /scaffold names, supported kinds, target paths, generated bytes/paths, rollback behavior, or security guarantees.",
      "Removing, disabling, or converting /scaffold primitive to deprecation-only behavior without an approved release-level compatibility revision.",
      "Refactoring unrelated command implementations.",
      "Committing, pushing, releasing, or deploying."
    ]
  },
  "constraints": [
    "After initiatives 01-03 establish provider and HUD boundaries, this initiative may proceed in parallel with 04-pi-swe-todo-separation and 05-pi-artifacts-publication-backend; it does not depend on their completion.",
    "No runtime or test reference may remain to pi-catalog/templates after migration.",
    "Golden previews and applied generated trees must remain byte-for-byte compatible for all scaffold kinds.",
    "Preserve containment, symlink, collision, staging, commit, and rollback safety.",
    "For this initiative set, retain /scaffold primitive unchanged; the consolidation plan's removal/deprecation step is explicitly deferred until a separately approved breaking-change revision.",
    "Regenerate and verify catalog/gentic-inventory.json and related capability fixtures when paths/ownership change."
  ],
  "acceptanceCriteria": [
    {
      "id": "AC-1",
      "text": "All scaffold templates are owned beneath pi-commands and no production, test, documentation, or inventory reference points to pi-catalog/templates."
    },
    {
      "id": "AC-2",
      "text": "Scaffold planning, rendering, and transactional application are separate tested concerns."
    },
    {
      "id": "AC-3",
      "text": "/scaffold parsing, completions, supported kinds—including primitive—previews, generated bytes/paths, containment, rollback, and errors remain compatible."
    },
    {
      "id": "AC-4",
      "text": "pi-catalog contains no generation templates or scaffolding claims and retains compatible runtime discovery behavior."
    },
    {
      "id": "AC-5",
      "text": "Generated inventories and focused/full repository qualification pass with independent review."
    }
  ],
  "assessment": {
    "depth": "standard",
    "reason": "The ownership move is conceptually direct, but the 374-line scaffolder combines security-sensitive transactions with rendering and many golden outputs; byte and rollback compatibility require disciplined tests.",
    "surfaces": [
      "extensions/pi-commands/**",
      "extensions/pi-catalog/**",
      "catalog/gentic-inventory.json",
      "tsconfig/resource/anatomy checks",
      "scaffold and catalog tests"
    ],
    "unknowns": [
      "Some generated inventory fixtures may embed template paths not obvious from source references.",
      "Git history-preserving moves depend on the final file mapping discovered during implementation."
    ]
  },
  "practices": [
    {
      "id": "P-1",
      "practice": "Golden and transactional characterization",
      "appliesTo": [
        "W-1"
      ],
      "reason": "Every scaffold kind and failure path must be frozen before moving templates or splitting code."
    },
    {
      "id": "P-2",
      "practice": "Ownership-preserving modular extraction",
      "appliesTo": [
        "W-2"
      ],
      "reason": "Planning, rendering, and application should separate without introducing a new cross-extension dependency."
    },
    {
      "id": "P-3",
      "practice": "Inventory and compatibility qualification",
      "appliesTo": [
        "W-3"
      ],
      "reason": "Resource discovery, generated inventories, public commands, and security need integrated and independent evidence."
    }
  ],
  "obligations": [
    {
      "id": "O-1",
      "practiceId": "P-1",
      "criterionIds": [
        "AC-3"
      ],
      "text": "Run golden preview/apply and negative transaction tests for every scaffold kind, including primitive, containment, symlink, collision, partial failure, rollback, completions, and unusual names before migration.",
      "verification": {
        "kind": "scaffold-characterization",
        "requiredEvidence": [
          "machine-command"
        ]
      }
    },
    {
      "id": "O-2",
      "practiceId": "P-2",
      "criterionIds": [
        "AC-1",
        "AC-2",
        "AC-3",
        "AC-4"
      ],
      "text": "Verify history-preserving template relocation, zero old-path references, distinct planning/rendering/application modules, unchanged generated bytes, unchanged primitive scaffolding, and unchanged catalog discovery.",
      "verification": {
        "kind": "ownership-and-module-tests",
        "requiredEvidence": [
          "machine-command",
          "model-review"
        ]
      }
    },
    {
      "id": "O-3",
      "practiceId": "P-3",
      "criterionIds": [
        "AC-3",
        "AC-4",
        "AC-5"
      ],
      "text": "Regenerate/check inventories and run scaffold, catalog, typecheck, resource, command, performance, and full repository gates, then obtain independent review of ownership, compatibility, and transaction safety.",
      "verification": {
        "kind": "commands-catalog-release-qualification",
        "requiredEvidence": [
          "machine-command",
          "independent-review"
        ]
      }
    }
  ],
  "work": [
    {
      "id": "W-1",
      "kind": "task",
      "title": "Characterize all scaffold outputs and transaction behavior",
      "status": "complete",
      "dependsOn": [],
      "criterionIds": [
        "AC-3"
      ],
      "obligationIds": [
        "O-1"
      ],
      "testing": {
        "approach": "Capture golden bytes/trees and negative planning/application behavior for every supported kind before moving files.",
        "reason": "Template and module moves must be demonstrably behavior-neutral."
      }
    },
    {
      "id": "W-2",
      "kind": "task",
      "title": "Move templates to pi-commands and split the scaffolder",
      "status": "complete",
      "dependsOn": [
        "W-1"
      ],
      "criterionIds": [
        "AC-1",
        "AC-2",
        "AC-3",
        "AC-4"
      ],
      "obligationIds": [
        "O-2"
      ],
      "testing": {
        "approach": "Move templates, update bounded path resolution, extract planning/rendering/application modules, and rerun goldens plus catalog tests.",
        "reason": "This corrects inverted ownership while reducing the scaffolder's concentration of concerns."
      }
    },
    {
      "id": "W-3",
      "kind": "task",
      "title": "Refresh inventories and qualify commands/catalog ownership",
      "status": "complete",
      "dependsOn": [
        "W-2"
      ],
      "criterionIds": [
        "AC-5"
      ],
      "obligationIds": [
        "O-3"
      ],
      "testing": {
        "approach": "Check for stale paths, regenerate inventories, run complete gates, and obtain independent source-bound review.",
        "reason": "Repository resource metadata and public compatibility must agree with the new ownership."
      }
    }
  ],
