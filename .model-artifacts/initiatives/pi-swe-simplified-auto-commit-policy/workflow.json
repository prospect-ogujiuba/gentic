{
  "kind": "gentic.swe.initiative",
  "schemaVersion": 1,
  "id": "pi-swe-simplified-auto-commit-policy",
  "revision": 11,
  "status": "complete",
  "objective": "Simplify the opt-in work-item completion commit policy to a single initiative-level boolean that automatically derives scoped paths from successful verification evidence and commit messages from work titles, while retaining safe optional overrides only where necessary.",
  "scope": {
    "in": [
      "Boolean commitOnWorkCompletion initiative policy",
      "Automatic path derivation from current successful verification evidence",
      "Automatic conventional commit message derivation from work-item titles",
      "Backward-safe schema, completion integration, documentation, and regression tests"
    ],
    "out": [
      "Automatic pushes",
      "Global configuration defaults",
      "Committing paths not attributable through current successful evidence",
      "Changing evidence completion requirements"
    ]
  },
  "constraints": [
    "The common configuration must be commitOnWorkCompletion: true with no required per-work mapping.",
    "Omitted or false policy values must preserve current behavior.",
    "Derived paths must come from current successful evidence for the completed work item and include workflow.json.",
    "Unsafe paths, runtime logs, .gitignore, and Git metadata must remain excluded.",
    "Optional overrides may exist only if they keep the common case simple and preserve closed-schema validation.",
    "Git execution must continue through Pi's ordinary bash permission boundary and never push.",
    "Existing uncommitted implementation changes must be evolved in place without losing verified safety behavior."
  ],
  "acceptanceCriteria": [
    {
      "id": "AC-1",
      "text": "An initiative opts in with a single boolean commitOnWorkCompletion value; omitted or false values disable completion commits."
    },
    {
      "id": "AC-2",
      "text": "On successful work completion, pi-swe derives literal scoped paths from the work item's current passing verification evidence, adds workflow.json, and derives a concise conventional commit message from the work title."
    },
    {
      "id": "AC-3",
      "text": "Missing attributable paths, unsafe paths, unrelated changes, empty diffs, hooks, and Git failures remain fail-safe and actionable without pushing or reverting completion."
    },
    {
      "id": "AC-4",
      "text": "Documentation and focused/full repository verification cover the simplified configuration, derivation rules, and failure behavior."
    }
  ],
  "assessment": {
    "depth": "standard",
    "reason": "This simplifies a just-added durable schema while preserving security-sensitive path attribution and Git permission behavior.",
    "surfaces": [
      "pi-swe initiative schema",
      "verification evidence path derivation",
      "completion commit preparation",
      "tool and command guidance",
      "documentation and tests"
    ],
    "unknowns": [
      "Model-review and machine-command evidence may reference overlapping paths and require deterministic deduplication.",
      "Some work titles may need deterministic normalization to valid conventional commit messages."
    ]
  },
  "practices": [
    {
      "id": "P-1",
      "practice": "Simple defaults with evidence-derived behavior",
      "appliesTo": [
        "W-1"
      ],
      "reason": "Users should opt in once while existing evidence supplies safe attribution and work metadata supplies the message."
    },
    {
      "id": "P-2",
      "practice": "Fail-safe Git and permission boundaries",
      "appliesTo": [
        "W-1"
      ],
      "reason": "Simplification must not weaken scoped commits, unrelated-change preservation, or ordinary bash authorization."
    },
    {
      "id": "P-3",
      "practice": "Focused and full regression qualification",
      "appliesTo": [
        "W-1"
      ],
      "reason": "Schema, derivation, lifecycle, Git integration, and documentation all require coverage."
    }
  ],
  "obligations": [
