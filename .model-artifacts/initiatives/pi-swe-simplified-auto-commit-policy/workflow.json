      ],
      "summary": "Model self-review (not independent or human approval): no blocking findings. The policy is now a closed boolean whose omission or false value preserves existing behavior and whose value participates in the contract fingerprint. Completion preparation aggregates only passing evidence for the completed work item with the current contract fingerprint, deterministically deduplicates and sorts safe paths, excludes traversal, wildcard pathspecs, Git metadata, .gitignore, and logs, adds workflow.json, and derives a bounded lowercase conventional message from the work title. Missing safe attributable paths return completionCommitError while leaving completion durable. Git execution remains an exact ordinary-bash follow-up using an isolated index, preserves unrelated paths outside evidence scope, and never pushes. Focused tests cover boolean validation, disabled behavior, stale/unsafe filtering, deterministic aggregation, generated messages, service integration, isolated-index success, empty scope, and hook failure; documentation accurately states that verification relevantPaths define attribution. Full qualification passed all 234 tests sequentially after two unrelated concurrent pi-hud timeout flakes in the default parallel runner.",
      "provenance": {
        "kind": "pi-model-self-review",
        "sessionId": "01a0cf92-40e8-74cb-9306-ff7ac2babd6d"
      }
    }
  ],
  "decisions": [
    {
      "id": "D-1",
      "text": "The common policy shape is commitOnWorkCompletion: true.",
      "basis": "Explicit user preference for the simpler design."
    },
    {
      "id": "D-2",
      "text": "Paths derive from current successful verification evidence and the authority path; messages derive from the work title.",
      "basis": "Existing workflow data already provides attribution and naming inputs."
    },
    {
      "id": "D-3",
      "text": "Commit execution remains an ordinary bash follow-up and never pushes.",
      "basis": "Preserve the established permission boundary and Git safety semantics."
    }
  ],
  "risks": [
    {
      "id": "R-1",
      "text": "Verification paths may omit a changed implementation file.",
      "mitigation": "Fail with actionable guidance when no attributable paths exist and document that verification relevantPaths define commit scope."
    },
    {
      "id": "R-2",
      "text": "Stale evidence could accidentally attribute old paths.",
      "mitigation": "Use only current-contract, passing evidence for the completed work item."
    },
    {
      "id": "R-3",
      "text": "Generated messages may be awkward or invalid.",
      "mitigation": "Apply deterministic bounded normalization with a stable conventional prefix and focused tests."
    }
  ]
}
