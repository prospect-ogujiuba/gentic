        "AC-3",
        "AC-4"
      ],
      "obligationIds": [
        "O-2"
      ],
      "testing": {
        "approach": "Implement a least-capability backend, migrate pi-artifacts and context reports, and rerun consumer and adversarial tests.",
        "reason": "Centralization is valuable only if it reduces duplication without broadening write authority."
      }
    },
    {
      "id": "W-3",
      "kind": "task",
      "title": "Document ownership and qualify publication safety",
      "status": "complete",
      "dependsOn": [
