  "decisions": [
    {
      "id": "D-1",
      "text": "Share artifact/report publication mechanics but not pi-swe workflow authority publication.",
      "basis": "workflow.json has stronger lifecycle and identity invariants and must remain exclusively owned by pi-swe."
    },
    {
      "id": "D-2",
      "text": "Keep pi-artifacts public behavior unchanged.",
      "basis": "The review identifies it as the best-designed extension and recommends only optional utility extraction."
    },
    {
      "id": "D-3",
      "text": "Run this work in the same post-provider wave as initiatives 04 and 06 when capacity permits.",
      "basis": "The consolidation plan identifies UI, publication, and scaffolding migrations as separate regression surfaces that need not block one another."
    }
  ],
  "risks": [
    {
      "id": "R-1",
      "text": "Generalization weakens path or race defenses.",
      "mitigation": "Use a shared adversarial matrix and a minimal capability-oriented API."
    },
    {
      "id": "R-2",
      "text": "Context reports change names or bytes.",
      "mitigation": "Retain golden path/content fixtures for Markdown and JSON outputs."
    },
    {
      "id": "R-3",
      "text": "The backend becomes a route around SweService.",
      "mitigation": "Explicitly deny workflow.json and independently review write-authority boundaries."
    }
  ]
}
