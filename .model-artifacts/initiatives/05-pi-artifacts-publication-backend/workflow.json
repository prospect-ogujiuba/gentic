        "approach": "Extend golden and adversarial fixtures before moving any publication primitive.",
        "reason": "Safe extraction requires a proven behavioral and security baseline."
      }
    },
    {
      "id": "W-2",
      "kind": "task",
      "title": "Extract and adopt the safe publication backend",
      "status": "complete",
      "dependsOn": [
        "W-1"
      ],
      "criterionIds": [
        "AC-1",
