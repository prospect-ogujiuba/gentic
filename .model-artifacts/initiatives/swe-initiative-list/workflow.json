  "decisions": [
    {
      "id": "D-1",
      "text": "Keep /swe list <topic> as the detailed docket and use bare /swe list for initiative overview.",
      "basis": "Adds natural list semantics without breaking existing usage."
    }
  ],
  "risks": [
    {
      "id": "R-1",
      "text": "Initiative discovery logic could diverge between autocomplete and list output.",
      "mitigation": "Export and reuse a single discovery and summary projection."
    },
    {
      "id": "R-2",
      "text": "Overview output could become unbounded in repositories with many initiatives.",
      "mitigation": "Retain the existing discovery cap and add an explicit display limit with omitted-count messaging."
    }
  ]
}
