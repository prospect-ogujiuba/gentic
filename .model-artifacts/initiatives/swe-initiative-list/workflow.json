  "id": "swe-initiative-list",
  "revision": 11,
  "status": "complete",
  "objective": "Make bare /swe list display a bounded, well-formatted overview of discovered initiatives while preserving /swe list <topic> as the detailed work docket.",
  "scope": {
    "in": [
      "extensions/pi-swe command parsing and autocomplete discovery",
      "initiative overview formatting",
      "pi-swe command/runtime tests",
      "pi-swe public command documentation"
    ],
    "out": [
      "interactive initiative picker",
      "changes to structured swe tool actions",
      "initiative schema changes"
    ]
  },
  "constraints": [
    "Reuse the same validated initiative discovery and ranking semantics as autocomplete.",
    "Bare /swe list must not change focused initiative.",
    "Preserve backward compatibility for /swe list <topic>."
  ],
  "acceptanceCriteria": [
    {
      "id": "AC-1",
      "text": "Running /swe list without a topic renders a bounded overview of valid initiatives with focus, status, revision, progress, and current or next work detail."
    },
    {
      "id": "AC-2",
      "text": "Running /swe list <topic> retains the existing detailed work docket and focus behavior."
    },
    {
      "id": "AC-3",
      "text": "Autocomplete, help, and documentation show the topic as optional and automated tests cover bare and topic-specific list behavior."
    }
  ],
  "assessment": {
    "depth": "light",
    "reason": "This is a contained command parsing and presentation change using existing validated discovery logic.",
    "surfaces": [
      "command adapter",
      "autocomplete discovery",
