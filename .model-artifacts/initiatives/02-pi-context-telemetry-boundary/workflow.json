  "decisions": [
    {
      "id": "D-1",
      "text": "Preserve /pi-context json and Markdown reporting.",
      "basis": "The consolidation plan explicitly retains JSON through a typed system-artifact operation."
    },
    {
      "id": "D-2",
      "text": "Prefer explicit contributor degradation over deep fallback introspection.",
      "basis": "The architecture defect is disproportionate complexity and sensitivity to undocumented runtime shapes."
    }
  ],
  "risks": [
    {
      "id": "R-1",
      "text": "Native telemetry lacks contributor detail users currently see.",
      "mitigation": "Preserve authoritative aggregate usage and expose bounded explicit degradation instead of guessing."
    },
    {
      "id": "R-2",
      "text": "Simplification accidentally weakens content-safety guarantees.",
      "mitigation": "Use adversarial prohibited-content fixtures and source-bound privacy review."
    },
    {
      "id": "R-3",
      "text": "Report compatibility changes during service extraction.",
      "mitigation": "Retain golden naming/content fixtures for both JSON and Markdown modes."
    }
  ]
}
