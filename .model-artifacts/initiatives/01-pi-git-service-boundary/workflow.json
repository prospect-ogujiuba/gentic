  "decisions": [
    {
      "id": "D-1",
      "text": "pi-git owns Git collection and parsing; the shared process service owns only bounded execution mechanics.",
      "basis": "This preserves narrow domain ownership and avoids a shared-service monolith."
    },
    {
      "id": "D-2",
      "text": "The initial dependency guard is delivered here before extraction; initiative 03 owns removal of the exact HUD exceptions.",
      "basis": "This matches the consolidation plan's ordering while preserving one clear migration owner."
    },
    {
      "id": "D-3",
      "text": "No pi-git public redesign is included.",
      "basis": "The architecture review judges the extension basically good and recommends extraction rather than replacement."
    }
  ],
  "risks": [
    {
      "id": "R-1",
      "text": "Moving process code changes cancellation or output-limit semantics.",
      "mitigation": "Characterize those behaviors first and exercise timeout, abort, oversized-output, and shutdown cases after extraction."
    },
    {
      "id": "R-2",
      "text": "The new service becomes an unbounded general utility.",
      "mitigation": "Keep its typed API minimal and scoped to existing proven bounded execution needs."
    },
    {
      "id": "R-3",
      "text": "Temporary dependency exceptions become permanent.",
      "mitigation": "Require exact stale-detecting entries and make their removal an explicit initiative 03 completion criterion."
    }
  ]
}
