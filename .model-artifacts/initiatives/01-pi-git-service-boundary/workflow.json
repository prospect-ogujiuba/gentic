{
  "kind": "gentic.swe.initiative",
  "schemaVersion": 1,
  "id": "01-pi-git-service-boundary",
  "revision": 28,
  "status": "complete",
  "objective": "Establish the production extension-dependency guard, then extract a supported bounded-process and Git snapshot service boundary from pi-git, separating process supervision, collection, parsing, and rendering while preserving git_snapshot and /pi-git behavior and enabling pi-hud to consume stable contracts.",
  "policies": {
    "commitOnWorkCompletion": true,
    "independentReviewOnCompletion": true
  },
  "scope": {
    "in": [
      "Add the production-source architecture check that rejects imports resolving beneath sibling extension private src trees, initially with exact stale-detecting exceptions only for current pi-hud violations.",
      "Characterize current pi-git tool, command, cancellation, bounds, error, parsing, and rendering behavior.",
      "Move bounded subprocess execution into a small package-level service without registration side effects.",
      "Define a typed Git snapshot contract and separate collection/parsing from presentation.",
      "Update pi-git adapters to use the supported service and export only the contract intended for sibling consumers.",
      "Document the supported boundary and hand temporary guard exceptions to initiative 03 for mandatory removal."
    ],
    "out": [
      "Changing git_snapshot fields, /pi-git output semantics, timeouts, limits, or cancellation behavior.",
      "Refactoring pi-hud itself or removing its temporary exceptions; initiative 03 owns consumer migration and final zero-allowlist enforcement.",
      "Creating a general-purpose process framework or moving unrelated subprocess code.",
      "Scanning test fixtures as production dependency violations.",
      "Committing, pushing, releasing, or deploying."
    ]
  },
  "constraints": [
    "Preserve public tool and command names and structured output compatibility.",
    "Keep process execution bounded, cancellable, output-limited, and free of shell interpolation regressions.",
    "Shared contracts and services must have no Pi registration or UI side effects.",
    "The architecture check scans production extension source only; any initial exception must name the exact file/import, fail when stale, and be removed by initiative 03.",
    "Do not duplicate context telemetry or artifact publication responsibilities.",
    "Current source and tests must be inspected before edits; intentionally revise this authority if they invalidate its contract."
  ],
  "acceptanceCriteria": [
    {
      "id": "AC-1",
      "text": "git_snapshot and /pi-git retain compatible outputs, bounds, cancellation, and structured error behavior."
    },
    {
      "id": "AC-2",
      "text": "Bounded process supervision is owned by a supported small service rather than pi-git's snapshot orchestration module."
    },
    {
      "id": "AC-3",
      "text": "Git collection and parsing are separated from rendering behind a typed snapshot contract usable without importing pi-git private src internals."
    },
    {
      "id": "AC-4",
      "text": "Focused and repository qualification passes, and documentation identifies the supported consumer boundary."
    },
    {
      "id": "AC-5",
      "text": "A production-source dependency check runs before service extraction, rejects new sibling private-src imports, and permits only exact stale-detecting temporary HUD exceptions owned for removal by initiative 03."
    }
  ],
  "assessment": {
    "depth": "standard",
    "reason": "The extension is narrow, but process cancellation, resource bounds, a new shared contract, and an early architecture guard affect downstream HUD decoupling and repository boundaries.",
    "surfaces": [
      "extensions/pi-git/**",
      "production extension dependency checks",
      "src/contracts/**",
      "src/services/**",
      "test/pi-git*.test.ts",
      "docs and extension anatomy checks"
    ],
    "unknowns": [
      "The exact package-level filenames should follow existing repository conventions discovered during implementation.",
      "Additional internal consumers of execBounded may need migration or explicit compatibility shims."
    ]
  },
  "practices": [
    {
      "id": "P-0",
      "practice": "Boundary guard before extraction",
      "appliesTo": [
        "W-0"
      ],
      "reason": "New sibling-private dependencies must be prevented before shared services begin moving."
    },
    {
      "id": "P-1",
      "practice": "Characterization-first refactoring",
      "appliesTo": [
        "W-1"
      ],
      "reason": "Existing observable Git behavior must remain stable while internal responsibilities move."
    },
    {
