{
  "kind": "gentic.swe.initiative",
  "schemaVersion": 1,
  "id": "08-standalone-pi-todo-extension",
  "revision": 16,
  "status": "complete",
  "objective": "Make pi-todo a genuinely standalone, independently discovered Pi extension while preserving SWE/Todo public behavior, authority boundaries, persistence, restart/fork semantics, and optional workflow projection integration.",
  "policies": {
    "commitOnWorkCompletion": false,
    "independentReviewOnCompletion": true
  },
  "scope": {
    "in": [
      "Create extensions/pi-todo/index.ts as the independent owner of Todo command/tool registration, session/project persistence, and Todo mutation.",
      "Remove Todo registration/composition ownership from extensions/pi-swe/index.ts so pi-swe runs correctly without pi-todo.",
      "Connect optional workflow projection through a public, order-independent Pi-native integration contract with no private sibling imports.",
      "Preserve public swe/todo command and tool names, scope selection, persistence formats, fork/restart behavior, malformed focused-authority fail-closed behavior, and finish-to-markImplemented-only semantics.",
      "Exercise pi-swe alone, pi-todo alone, both load orders, focus refresh, absent integration, and denied authority crossings.",
      "Update extension discovery metadata, profiles, catalog, inventory, anatomy, and documentation as required."
    ],
    "out": [
      "Changing workflow.json schema, lifecycle, evidence, review, completion, or commit semantics.",
      "Changing Todo persistence formats, public command/tool names, or scope-selection semantics.",
      "Adding a shared registry, secondary task ledger, private sibling imports, or load-order dependency.",
      "Committing, pushing, releasing, or deploying.",
      "Starting or modifying unrelated draft initiatives 05-07."
    ]
  },
  "constraints": [
    "workflow.json remains sole SWE authority and SweService remains its mutation authority.",
    "pi-todo owns Todo registration and canonical session/project Todo mutation independently of pi-swe.",
    "Optional integration must use native Pi extension APIs/public contracts and tolerate either registration order and either extension being absent.",
    "Todo finish may only request markImplemented for projected workflow work; it must never complete work or write evidence.",
    "src/ui/docket-kit remains presentation-only.",
    "Preserve predecessor initiative 04 history and all approved uncommitted changes.",
    "Use test-after for already-correct characterization; do not manufacture RED evidence.",
    "Run verification only through prepared ordinary bash commands and require independent review before completion."
  ],
  "acceptanceCriteria": [
    {
      "id": "AC-1",
      "text": "Pi discovers and loads extensions/pi-todo independently; Todo commands/tools and session/project persistence work when pi-swe is absent."
    },
    {
      "id": "AC-2",
      "text": "Pi-swe owns only workflow lifecycle/evidence/completion and works when pi-todo is absent."
    },
    {
      "id": "AC-3",
      "text": "Optional workflow projection integration is public, Pi-native, registration-order independent, refreshes focus correctly, fails closed on malformed authority, and permits only Todo finish to request markImplemented."
    },
    {
      "id": "AC-4",
      "text": "Existing public swe/todo names, scopes, formats, fork/restart behavior, and presentation-only docket boundary remain compatible."
    },
    {
      "id": "AC-5",
      "text": "Focused standalone/load-order/authority tests and full repository qualification pass with independent review."
    }
  ],
  "assessment": {
    "depth": "deep",
    "reason": "Extension discovery and optional cross-extension lifecycle projection affect durable workflow authority, persistence, registration order, and public command/tool compatibility.",
    "surfaces": [
      "extensions/pi-todo/**",
      "extensions/pi-swe/index.ts",
      "extensions/pi-swe/src/pi/register.ts",
      "extensions/pi-swe/integrations/**",
      "src/pi-todo/**",
      "src/release/inventory.ts",
      "catalog/**",
      "docs/**",
      "test/pi-todo*.test.ts",
      "test/pi-swe*.test.ts",
      "test/runtime-command-guidance.test.ts"
    ],
    "unknowns": [
      "The minimal Pi-native event protocol needed for two-way order-independent discovery and focus refresh must be validated against installed Pi extension APIs.",
      "Generated catalog/inventory/anatomy outputs may require source metadata updates before regeneration."
    ]
  },
  "practices": [
    {
      "id": "P-1",
      "practice": "Standalone boundary implementation with compatibility tests",
      "appliesTo": [
        "W-1"
      ],
      "reason": "Independent loading and optional integration must preserve authority and persistence contracts in all extension combinations and load orders."
    },
    {
      "id": "P-2",
      "practice": "Discovery qualification and independent source-bound review",
      "appliesTo": [
        "W-2"
      ],
      "reason": "Native discovery metadata, generated inventories, documentation, and full gates must prove the split is complete."
    }
  ],
  "obligations": [
    {
      "id": "O-1",
      "practiceId": "P-1",
      "criterionIds": [
        "AC-1",
        "AC-2",
        "AC-3",
        "AC-4"
      ],
      "text": "Implement and test independent pi-todo/pi-swe loading, both registration orders, dynamic focus refresh, absent integration, malformed authority fail-closed behavior, fork/restart compatibility, and denied authority crossings including finish-to-markImplemented-only.",
      "verification": {
        "kind": "standalone-extension-boundary-tests",
        "requiredEvidence": [
          "machine-command",
          "model-review"
        ]
      }
    },
    {
      "id": "O-2",
      "practiceId": "P-2",
      "criterionIds": [
        "AC-1",
        "AC-4",
        "AC-5"
      ],
      "text": "Verify native discovery, profiles, catalog, inventory, anatomy, documentation, focused suites, typecheck, command inventory, and full repository tests, then obtain independent source-bound review.",
      "verification": {
        "kind": "standalone-pi-todo-qualification",
        "requiredEvidence": [
          "machine-command",
          "independent-review"
        ]
      }
    }
  ],
  "work": [
