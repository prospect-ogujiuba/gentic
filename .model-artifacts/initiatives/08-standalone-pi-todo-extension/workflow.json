      "dimensions": [
        "correctness",
        "extension-discovery",
        "authority-separation",
        "registration-order-independence",
        "persistence-and-restart-compatibility",
        "failure-closure",
        "test-and-metadata-coverage"
      ],
      "summary": "Independently review the twice-corrected standalone pi-todo extraction. Prior reviews found (1) restored focus did not refresh Todo in todo-first order and (2) cleared focus left stale workflow presentation while malformed restored authority could reject startup. Corrections now: SWE session_start awaits contained projection refresh for restored and cleared focus; continuation ignores invalid restored authority without clearing it; Todo lifecycle refresh displays unavailable rather than falling back on provider failure; both load orders test focused, cleared, restored, and malformed startup. Verify those fixes plus standalone ownership, native public event integration, no private sibling imports/registry/ledger, finish-to-markImplemented-only, persistence/scopes/names compatibility, and metadata/docs. Current full gate passes typecheck, check, check:commands, 272 tests.",
      "provenance": {
        "kind": "pi-interactive-session-review",
        "transport": "interactive-shell",
        "reviewerSessionId": "pi-todo-independent-review-3",
        "recorderSessionId": "01a0db5d-1fac-70b5-a2ab-e86957c0bc5f"
      }
    }
  ],
  "decisions": [
    {
      "id": "D-1",
      "text": "Use Pi native extension events and public contracts for optional workflow projection rather than direct sibling imports or a registry.",
      "basis": "Pi documentation identifies pi.events as the supported cross-extension communication surface and event registration is available in either load order."
    },
    {
      "id": "D-2",
      "text": "Keep Todo and SWE as separately discoverable extension entrypoints.",
      "basis": "Pi discovers extension subdirectories with index.ts independently, allowing either product to be absent."
    }
  ],
  "risks": [
    {
      "id": "R-1",
      "text": "Cross-extension integration becomes registration-order dependent or misses focus changes.",
      "mitigation": "Use symmetric event handshake/subscription behavior and test both load orders plus dynamic refresh."
    },
    {
      "id": "R-2",
      "text": "Todo accidentally gains workflow completion or evidence authority.",
      "mitigation": "Expose only projection/status/start/markImplemented operations and test denied completion/evidence crossings."
    },
    {
      "id": "R-3",
      "text": "Generated discovery metadata or public behavior drifts.",
      "mitigation": "Regenerate/check catalog and inventory and run focused plus full repository gates."
    }
  ]
}
