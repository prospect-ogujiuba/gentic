      "testing": {
        "approach": "Preserve existing characterization, add import/ownership architecture assertions, regenerate inventories, run focused and full repository checks, then independent review.",
        "reason": "Behavior-neutral relocation should use passing regression evidence rather than artificial RED failures."
      }
    }
  ],
