{
  "kind": "gentic.swe.initiative",
  "schemaVersion": 1,
  "id": "07-pi-todo-extension-ownership",
  "revision": 9,
  "status": "complete",
  "objective": "Make pi-todo own its implementation under extensions/pi-todo/src, retaining only genuinely shared contracts and presentation utilities in root src while preserving standalone Todo and optional SWE integration behavior.",
  "policies": {
    "commitOnWorkCompletion": false,
    "independentReviewOnCompletion": true
  },
  "scope": {
    "in": [
      "Relocate Todo-specific state, persistence, command adapters, registration and UI implementation into extensions/pi-todo/src.",
      "Separate shared Todo/workflow contracts and shared docket presentation from extension-private implementation.",
      "Update consumers, tests, documentation, anatomy and generated inventory to reflect actual ownership.",
      "Verify native discovery, standalone loading, optional SWE integration, persistence, scope semantics and UI compatibility."
    ],
    "out": [
      "Changing public commands, tools, persistence formats, workflow authority or evidence gates.",
      "Committing, pushing or modifying unrelated initiatives.",
      "Adding a runtime registry or duplicate Todo implementation."
    ]
  },
  "constraints": [
    "Keep Pi native extension discovery and event-based optional integration.",
    "No SWE import of private Todo implementation; only explicit shared contracts and presentation utilities may cross ownership boundaries.",
    "Do not leave root src/pi-todo as the real implementation behind a thin facade.",
    "Preserve unrelated worktree changes."
  ],
  "acceptanceCriteria": [
    {
      "id": "AC-1",
      "text": "Todo-specific implementation lives inside extensions/pi-todo/src; root src contains only justified shared contracts/presentation code."
    },
    {
      "id": "AC-2",
      "text": "SWE and Todo remain independently loadable with compatible registration, events, scopes, persistence and UI."
    },
    {
      "id": "AC-3",
      "text": "Ownership tests, documentation, anatomy and generated inventories agree with actual file ownership."
    },
    {
      "id": "AC-4",
      "text": "Focused and full qualification plus independent review pass."
    }
  ],
  "assessment": {
    "depth": "standard",
    "reason": "File ownership correction spans Todo runtime, persistence, UI and optional SWE consumers; shared contracts must avoid introducing sibling-private dependencies.",
    "surfaces": [
      "extensions/pi-todo",
      "src/pi-todo",
      "extensions/pi-swe/integrations",
      "extensions/pi-swe/src/ui",
      "src/ui/docket-kit",
      "test/pi-todo*.test.ts",
      "catalog/gentic-inventory.json"
    ],
    "unknowns": [
      "Which Todo-named UI modules are actually shared by SWE and must remain neutral presentation adapters."
    ]
  },
  "practices": [
    {
      "id": "P-1",
      "practice": "Ownership-preserving extraction and regression qualification",
      "appliesTo": [
        "W-1"
      ],
      "reason": "Relocate implementation without changing runtime semantics or creating private cross-extension imports."
    }
  ],
  "obligations": [
    {
      "id": "O-1",
      "practiceId": "P-1",
      "criterionIds": [
        "AC-1",
        "AC-2",
        "AC-3",
        "AC-4"
      ],
      "text": "Verify extension-local implementation and neutral shared contracts, independent Todo/SWE discovery and integration, unchanged behavior, accurate inventory, full repository gates and independent source review.",
      "verification": {
        "kind": "todo-ownership-qualification",
        "requiredEvidence": [
          "machine-command",
          "model-review",
          "independent-review"
        ]
      }
    }
  ],
  "work": [
    {
      "id": "W-1",
      "kind": "task",
      "title": "Consolidate Todo implementation into its extension and qualify ownership",
      "status": "complete",
