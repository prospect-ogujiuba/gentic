      ],
      "text": "Add regression coverage and implement refresh wiring so successful SWE mutations immediately update todo completions and presentation without changing authority selection.",
      "verification": {
        "kind": "focused integration tests",
        "requiredEvidence": [
          "machine-command"
        ],
        "sequence": "red-green"
      }
    },
    {
