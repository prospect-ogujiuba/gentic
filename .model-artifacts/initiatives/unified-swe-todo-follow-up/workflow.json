{
  "kind": "gentic.swe.initiative",
  "schemaVersion": 1,
  "id": "unified-swe-todo-follow-up",
  "revision": 22,
  "status": "complete",
  "objective": "Close review gaps in the unified pi-swe todo surface by refreshing todo presentation after SWE mutations, aligning missing-authority documentation with fail-closed behavior, and preserving short-timeout HUD coverage without load-sensitive assertions.",
  "scope": {
    "in": [
      "Refresh cached todo command completions and visible presentation after successful SWE lifecycle mutations",
      "Add regression coverage for cross-surface SWE-to-todo refresh behavior",
      "Align pi-swe documentation with fail-closed missing or unreadable focused authority behavior",
      "Restore short configured HUD timeout coverage while retaining a load-tolerant promptness bound",
      "Run focused and full qualification"
    ],
    "out": [
      "Changing todo or workflow authority semantics",
      "Changing workflow schema or evidence gates",
      "Committing or pushing changes"
    ]
  },
  "constraints": [
    "Workflow mutations must continue to route only through SweService",
    "Todo execution must continue to resolve authority afresh and never synchronize standalone state",
    "Refresh integration must not introduce duplicate registrations or circular extension ownership",
    "HUD production timeout behavior must remain unchanged"
  ],
  "acceptanceCriteria": [
    {
      "id": "AC-1",
      "text": "After successful SWE mutations, todo completions and visible status/widget presentation reflect current workflow or standalone authority without requiring a todo operation."
    },
    {
      "id": "AC-2",
      "text": "Documentation accurately states that missing or unreadable focused workflow authority fails closed, and HUD tests retain coverage of a short configured timeout with a load-tolerant wall-clock assertion."
    },
    {
      "id": "AC-3",
      "text": "Typecheck, focused unified todo and SWE tests, full tests, repository checks, and release verification pass with current evidence."
    }
  ],
  "assessment": {
    "depth": "standard",
    "reason": "The fixes are small but cross command/tool lifecycle events, cached UI state, documentation, and a concurrency-sensitive process test.",
    "surfaces": [
      "extensions/pi-swe registration",
      "unified todo surface",
      "todo/SWE integration tests",
      "pi-swe documentation",
      "HUD snapshot tests"
    ],
    "unknowns": [
      "Whether the cleanest refresh boundary is a callback from the SWE registrar or a provider-neutral refresh function",
      "Whether the restored 200ms timeout remains stable under the full concurrent suite with a relaxed wall-clock bound"
    ]
  },
  "practices": [
    {
      "id": "P-1",
      "practice": "Regression-first lifecycle integration",
      "appliesTo": [
        "W-1"
      ],
      "reason": "Cross-surface cached presentation behavior should be reproduced before changing refresh wiring."
    },
    {
      "id": "P-2",
