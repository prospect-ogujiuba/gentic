  "decisions": [
    {
      "id": "D-1",
      "text": "Defer the physical pi-primitives to pi-policies rename.",
      "basis": "Package filter paths are public compatibility surfaces and the consolidation plan recommends a major-release gate."
    },
    {
      "id": "D-2",
      "text": "Do not assume /scaffold primitive may be removed.",
      "basis": "The breaking-change window is unresolved; initiative 06 preserves it and this initiative requires explicit approval before changing it."
    },
    {
      "id": "D-3",
      "text": "Migrate policies individually rather than creating a replacement generic framework.",
      "basis": "The reviewed defect is the existence of a plugin system inside Pi's plugin/resource system."
    }
  ],
  "risks": [
    {
      "id": "R-1",
      "text": "Prompt policy text or trigger ordering changes during migration.",
      "mitigation": "Use per-policy golden injection and ordering tests."
    },
    {
      "id": "R-2",
      "text": "The old framework is recreated under a policy name.",
      "mitigation": "Review for discovery, generic loaders, trigger registries, and parallel enablement abstractions and reject them."
    },
    {
      "id": "R-3",
      "text": "Existing config or package filters break.",
      "mitigation": "Keep the path stable, parse legacy fields safely, and emit bounded migration diagnostics."
    },
    {
      "id": "R-4",
      "text": "Scaffold behavior conflicts with initiative 06.",
      "mitigation": "Treat initiative 06's preserved behavior as the baseline and require explicit release approval before removal/deprecation changes."
    }
  ]
}
