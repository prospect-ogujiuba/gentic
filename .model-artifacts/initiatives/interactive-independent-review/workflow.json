      "criterionIds": [
        "C-2",
        "C-3",
        "C-5"
      ],
      "text": "Verify runtime recording and completion gates reject self-session, stale, failed, malformed, and launch-only claims.",
      "verification": {
        "kind": "review-and-tests",
        "requiredEvidence": [
          "machine-command",
          "model-review"
        ]
      }
    },
    {
      "id": "O-3",
