        "C-6"
      ],
      "text": "Run integrated qualification and obtain a passing independent review from another interactive Pi session before finalization.",
      "verification": {
        "kind": "interactive-review-bootstrap",
        "requiredEvidence": [
          "machine-command",
          "model-review",
          "independent-review"
        ]
      }
    }
  ],
