{
  "kind": "gentic.swe.initiative",
  "schemaVersion": 1,
  "id": "interactive-independent-review",
  "revision": 19,
  "status": "complete",
  "objective": "Make an independent review performed by another Pi session through interactive_shell a required, evidence-gated part of every newly created SWE workflow, while preserving legacy workflow compatibility and existing configurable policies such as commitOnWorkCompletion.",
  "policies": {
    "commitOnWorkCompletion": false,
    "independentReviewOnCompletion": true
  },
  "scope": {
    "in": [
      "Add an independent interactive-session review evidence contract and provenance",
      "Require all newly created initiatives to opt into and complete independent review before finalization",
      "Add safe recording and completion gates that distinguish reviewer and recorder sessions",
      "Preserve and document the closed workflow policy schema including commitOnWorkCompletion",
      "Use an interactive shell session to independently review this implementation before completion",
      "Add schema, lifecycle, negative, compatibility, and runtime coverage"
    ],
    "out": [
      "Human identity authentication beyond Pi session provenance",
      "Replacing machine-command verification or model self-review",
      "Automatically accepting a launched but unfinished interactive session as review evidence",
      "Reopening or mutating completed historical initiatives",
      "Changing todo authority behavior"
    ]
  },
  "constraints": [
    "Repository workflow.json remains sole initiative authority",
    "Independent review must identify a reviewer session distinct from the recording session and interactive-shell provenance",
    "A launch acknowledgement alone must never satisfy review completion",
    "Legacy schema-version-1 workflow files must remain readable",
    "The implementation initiative itself must receive an independent interactive-shell review before finalization"
  ],
  "acceptanceCriteria": [
    {
      "id": "C-1",
      "text": "Every newly created initiative is configured to require a passing independent review before initiative finalization, while legacy workflow files remain readable."
    },
    {
      "id": "C-2",
      "text": "Independent-review evidence records bounded source paths, contract fingerprint, outcome, review dimensions and summary, plus interactive-shell reviewer-session provenance distinct from the recording session."
    },
    {
      "id": "C-3",
      "text": "Completion rejects missing, failed, stale, self-session, malformed, or launch-only review claims and accepts only current passing independent-review evidence."
    },
    {
      "id": "C-4",
      "text": "The closed policies schema continues to validate and document commitOnWorkCompletion and the new independent-review requirement without becoming a generic unvalidated configuration bag."
    },
    {
      "id": "C-5",
      "text": "Commands, structured tools, guidance, documentation, and tests explain and support the required interactive review workflow."
    },
    {
      "id": "C-6",
      "text": "This initiative is independently reviewed from another Pi session launched through interactive_shell before final completion."
    }
  ],
  "assessment": {
    "depth": "standard",
    "reason": "This changes workflow authority schema, runtime evidence provenance, completion gates, interactive-session operating procedure, compatibility, and documentation.",
    "surfaces": [
      "workflow schema",
      "verification evidence",
      "completion service",
      "Pi tool surface",
      "interactive shell workflow",
      "documentation",
      "tests"
    ],
    "unknowns": [
      "The strongest locally observable proof available for an independently completed interactive session without coupling pi-swe to a separate runtime registry."
    ]
  },
  "practices": [
    {
      "id": "P-1",
      "practice": "Closed-schema compatibility and negative lifecycle testing",
      "appliesTo": [
        "W-1"
      ],
      "reason": "New evidence and policy fields must remain bounded and preserve historical workflow readability."
    },
    {
      "id": "P-2",
      "practice": "Observed interactive-session provenance and completion-gate integration",
      "appliesTo": [
        "W-2"
      ],
      "reason": "The required review must be meaningfully distinct from self-review and must not be satisfied by merely launching a session."
    },
    {
      "id": "P-3",
      "practice": "Independent interactive review and integrated qualification",
      "appliesTo": [
        "W-2"
      ],
      "reason": "The feature changes completion assurance and must itself be reviewed through the mechanism it introduces."
    }
  ],
  "obligations": [
    {
