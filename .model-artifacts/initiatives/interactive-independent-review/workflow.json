  "decisions": [
    {
      "id": "D-1",
      "text": "Independent review is a distinct evidence kind, not an alias for the current model self-review.",
      "basis": "Current model-review provenance explicitly identifies pi-model-self-review and cannot truthfully claim independence."
    },
    {
      "id": "D-2",
      "text": "Require independent review for newly created initiatives while grandfathering readable historical schema-version-1 authorities.",
      "basis": "A hard parser break would strand active and completed repository authority."
    },
    {
      "id": "D-3",
      "text": "Interactive review must finish and be explicitly recorded; launching interactive_shell alone is insufficient.",
      "basis": "A launch acknowledgement proves neither review completion nor outcome."
    }
  ],
  "risks": [
    {
      "id": "R-1",
      "text": "Session IDs can be asserted without proving the reviewer produced the report.",
      "mitigation": "Prefer observed interactive-shell completion metadata or a source-bound review artifact and reject same-session provenance; document any residual trust boundary explicitly."
    },
    {
      "id": "R-2",
      "text": "Global review requirements can make light initiatives disproportionate or impossible when interactive_shell is unavailable.",
      "mitigation": "Keep the review bounded, use a fresh Pi session, provide precise failure guidance, and preserve legacy readability without silently bypassing new initiatives."
    },
    {
      "id": "R-3",
      "text": "Adding policy fields can invalidate existing workflows or commit opt-in behavior.",
      "mitigation": "Use optional backward-compatible parsing with strict defaults for new creation and regression-test commit preparation."
    },
    {
      "id": "R-4",
      "text": "A launched interactive session could be mistaken for completed evidence.",
      "mitigation": "Gate on an explicit completed review record with passing outcome, source freshness, and distinct reviewer provenance."
    }
  ]
}
