{
  "kind": "gentic.swe.initiative",
  "schemaVersion": 1,
  "id": "swe-lifecycle-autonomy",
  "revision": 9,
  "status": "complete",
  "objective": "Allow durable SWE initiatives to finalize at initiative level, continue authorized active workflows without babysitting, and recover cleanly from stale verification observations.",
  "scope": {
    "in": [
      "extensions/pi-swe lifecycle, context projection, command/tool surfaces, verification collector",
      "focused tests and pi-swe documentation"
    ],
    "out": [
      "unbounded autonomous execution",
      "bypassing evidence gates or shell permission boundaries",
      "automatic commit or push authorization"
    ]
  },
  "constraints": [
    "workflow.json remains the sole planning authority",
    "ordinary bash permission boundaries remain enforced",
    "automatic continuation applies only to a focused active initiative",
    "terminal or paused initiatives must not auto-run"
  ],
  "acceptanceCriteria": [
    {
      "id": "AC-1",
      "text": "The SWE complete action can finalize an initiative without workId once every executable work item is complete or intentionally disposed, and rejects premature finalization."
    },
    {
      "id": "AC-2",
      "text": "A focused active initiative explicitly instructs and triggers the agent to continue approved workflow work across startup/resume and command activation without asking for routine confirmation, while retaining clear stop conditions."
    },
    {
      "id": "AC-3",
      "text": "A new verification preparation can supersede a stale pending observation so failed or interrupted commands do not require runtime reload."
    },
    {
      "id": "AC-4",
      "text": "Tests and documentation describe and verify the lifecycle, continuation, and recovery behavior."
    }
  ],
  "assessment": {
    "depth": "standard",
    "reason": "This changes persisted lifecycle semantics and Pi runtime turn triggering, requiring focused safety and regression coverage.",
    "surfaces": [
      "domain lifecycle",
      "service API",
      "structured tool and slash command",
      "context injection",
      "verification collector",
      "tests and docs"
    ],
    "unknowns": [
      "Exact Pi timing of triggerTurn during session_start; behavior will be constrained to active focused authority and covered at handler boundary."
    ]
  },
  "practices": [
    {
      "id": "P-1",
      "practice": "Evidence-gated lifecycle invariants",
      "appliesTo": [
        "W-1"
      ],
      "reason": "Initiative finalization must not bypass work completion or dispositions."
    },
    {
      "id": "P-2",
      "practice": "Bounded autonomy with explicit safety stops",
      "appliesTo": [
        "W-1"
      ],
      "reason": "Continuation should reduce babysitting without inventing scope or bypassing permissions."
    },
    {
      "id": "P-3",
      "practice": "Focused regression verification",
      "appliesTo": [
        "W-1"
      ],
      "reason": "Lifecycle, event, and collector behavior need executable regression coverage."
    }
  ],
  "obligations": [
    {
      "id": "O-1",
      "practiceId": "P-1",
      "criterionIds": [
        "AC-1"
      ],
      "text": "Verify initiative-level completion succeeds only when all executable work is terminal.",
      "verification": {
        "kind": "focused-tests",
        "requiredEvidence": [
          "machine-command"
        ]
      }
    },
    {
      "id": "O-2",
      "practiceId": "P-2",
      "criterionIds": [
        "AC-2"
      ],
      "text": "Review continuation wording and triggers for bounded authorization and stop conditions.",
      "verification": {
        "kind": "tests-and-self-review",
        "requiredEvidence": [
          "machine-command",
          "model-review"
        ]
      }
    },
    {
      "id": "O-3",
      "practiceId": "P-3",
      "criterionIds": [
        "AC-3",
        "AC-4"
      ],
      "text": "Run focused and repository qualification covering stale observation recovery and documented surfaces.",
      "verification": {
        "kind": "repository-tests",
        "requiredEvidence": [
          "machine-command"
        ]
      }
    }
  ],
