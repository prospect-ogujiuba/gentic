{
  "name": "pi-marathon",
  "version": "0.1.0",
  "description": "Durable, restartable, verifier-driven long-running agent orchestration for Pi",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi-extension",
    "agent",
    "orchestration",
    "durable-agent"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./dist/extension/index.js"
    ]
  },
  "bin": {
    "pi-marathond": "./dist/bin/pi-marathond.js",
    "pi-marathonctl": "./dist/bin/pi-marathonctl.js"
  },
  "files": [
    "dist",
    "src",
    "examples",
    "test",
    "README.md",
    "ARCHITECTURE.md",
    "SECURITY.md",
    "CHANGELOG.md",
    "VALIDATION.md",
    "LICENSE",
    "tsconfig.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.4",
    "@earendil-works/pi-tui": "^0.84.4",
    "@types/node": "^22.19.19",
    "typebox": "^1.3.7",
    "typescript": "^5.9.3"
  }
}
